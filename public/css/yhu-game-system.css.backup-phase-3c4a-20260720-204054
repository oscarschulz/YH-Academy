    margin: 0;
    color: #aebbd1;
    font-size: 0.82rem;
    line-height: 1.5;
}

.yh-game-squad-mission-progress-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    color: #cbd5e1;
    font-size: 0.76rem;
}

.yh-game-squad-mission-progress-head span {
    color: #67e8f9;
    font-weight: 700;
}

