/* public/css/yhu-game-system.css */
/* YHU Dashboard Game Foundation v1 */

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-foundation {
    width: min(100%, 1480px);
    margin: 0 auto 20px;
    padding: clamp(14px, 1.5vw, 22px);
    display: grid;
    gap: 13px;
    color: #f8fbff;
    font-family: "Poppins", sans-serif;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-operator-panel {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns:
        minmax(0, 1.5fr)
        minmax(180px, 0.48fr)
        minmax(220px, 0.62fr);
    align-items: center;
    gap: 18px;
    padding: clamp(18px, 2vw, 28px);
    border: 1px solid rgba(103, 232, 249, 0.22);
    clip-path: polygon(
        18px 0,
        calc(100% - 18px) 0,
        100% 18px,
        100% 100%,
        0 100%,
        0 18px
    );
    background:
        radial-gradient(
            circle at 8% 0,
            rgba(56, 189, 248, 0.22),
            transparent 34%
        ),
        radial-gradient(
            circle at 92% 100%,
            rgba(99, 102, 241, 0.18),
            transparent 36%
        ),
        linear-gradient(
            135deg,
            rgba(10, 20, 48, 0.95),
            rgba(3, 9, 26, 0.94)
        );
    box-shadow:
        0 24px 60px rgba(0, 0, 0, 0.34),
        inset 0 1px 0 rgba(255, 255, 255, 0.06);
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-operator-panel::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.34;
    background-image:
        linear-gradient(
            rgba(103, 232, 249, 0.055) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(103, 232, 249, 0.055) 1px,
            transparent 1px
        );
    background-size: 36px 36px;
    mask-image: linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.8),
        transparent
    );
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-operator-copy,
body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-operator-rank,
body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-operator-progress {
    position: relative;
    z-index: 1;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-system-kicker,
body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-side-card-head small,
body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-division-heading small,
body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-rank-row small,
body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-next-objective small {
    color: #67e8f9;
    font-family: "Orbitron", "Rajdhani", sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-operator-copy h2 {
    margin: 5px 0 7px;
    color: #ffffff;
    font-family: "Rajdhani", "Poppins", sans-serif;
    font-size: clamp(2rem, 3vw, 3.3rem);
    line-height: 0.95;
    font-weight: 700;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-operator-copy p {
    max-width: 760px;
    margin: 0;
    color: #aebbd1;
    font-size: clamp(0.92rem, 1vw, 1rem);
    line-height: 1.58;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-operator-rank {
    display: grid;
    gap: 5px;
    padding-left: 22px;
    border-left: 1px solid rgba(103, 232, 249, 0.18);
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-operator-rank small {
    color: #94a3b8;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-operator-rank strong {
    color: #ffffff;
    font-family: "Rajdhani", "Poppins", sans-serif;
    font-size: clamp(1.5rem, 2vw, 2.1rem);
    line-height: 1;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-operator-rank span {
    color: #67e8f9;
    font-weight: 700;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-operator-progress {
    display: grid;
    gap: 10px;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-operator-progress > div:first-child {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: #aebbd1;
    font-size: 0.86rem;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-operator-progress strong {
    color: #ffffff;
    font-size: 1.1rem;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-progress-track {
    position: relative;
    width: 100%;
    height: 8px;
    overflow: hidden;
    border: 1px solid rgba(103, 232, 249, 0.16);
    background: rgba(255, 255, 255, 0.055);
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-progress-fill {
    position: absolute;
    inset: 0 auto 0 0;
    display: block;
    max-width: 100%;
    background:
        linear-gradient(
            90deg,
            #2563eb,
            #38bdf8,
            #67e8f9
        );
    box-shadow: 0 0 18px rgba(56, 189, 248, 0.5);
    transition: width 0.45s ease;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-division-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-division-card,
body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-side-card {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(223, 247, 255, 0.14);
    clip-path: polygon(
        14px 0,
        calc(100% - 14px) 0,
        100% 14px,
        100% 100%,
        0 100%,
        0 14px
    );
    background:
        radial-gradient(
            circle at 15% 0,
            rgba(56, 189, 248, 0.12),
            transparent 34%
        ),
        linear-gradient(
            180deg,
            rgba(8, 20, 43, 0.92),
            rgba(3, 9, 24, 0.9)
        );
    box-shadow:
        0 18px 42px rgba(0, 0, 0, 0.26),
        inset 0 1px 0 rgba(255, 255, 255, 0.045);
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-division-card {
    display: grid;
    align-content: start;
    gap: 11px;
    min-height: 286px;
    padding: 17px;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-division-card[data-yh-game-division="plaza"] {
    background:
        radial-gradient(
            circle at 15% 0,
            rgba(139, 92, 246, 0.16),
            transparent 34%
        ),
        linear-gradient(
            180deg,
            rgba(17, 14, 49, 0.94),
            rgba(4, 8, 25, 0.9)
        );
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-division-card[data-yh-game-division="federation"] {
    background:
        radial-gradient(
            circle at 15% 0,
            rgba(211, 178, 112, 0.16),
            transparent 34%
        ),
        linear-gradient(
            180deg,
            rgba(31, 25, 30, 0.94),
            rgba(5, 9, 23, 0.9)
        );
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-division-top {
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-division-icon {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(103, 232, 249, 0.3);
    color: #dff7ff;
    font-size: 1.18rem;
    background:
        radial-gradient(
            circle at 40% 20%,
            rgba(223, 247, 255, 0.22),
            transparent 42%
        ),
        rgba(37, 99, 235, 0.16);
    box-shadow: 0 0 20px rgba(56, 189, 248, 0.16);
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-division-heading h3,
body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-side-card h3 {
    margin: 3px 0 0;
    color: #ffffff;
    font-family: "Rajdhani", "Poppins", sans-serif;
    font-size: 1.42rem;
    line-height: 1;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-access-state,
body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-preview-badge {
    padding: 6px 9px;
    border: 1px solid rgba(148, 163, 184, 0.22);
    color: #94a3b8;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-access-state.is-approved {
    border-color: rgba(34, 197, 94, 0.32);
    color: #86efac;
    background: rgba(34, 197, 94, 0.08);
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-rank-row {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 14px;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-rank-row > div:first-child {
    display: grid;
    gap: 4px;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-rank-row > div:first-child strong {
    color: #ffffff;
    font-family: "Rajdhani", "Poppins", sans-serif;
    font-size: 1.35rem;
    line-height: 1;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-score {
    display: flex;
    align-items: baseline;
    gap: 2px;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-score strong {
    color: #ffffff;
    font-family: "Orbitron", sans-serif;
    font-size: 1.55rem;
    line-height: 1;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-score span {
    color: #64748b;
    font-size: 0.72rem;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-division-status {
    min-height: 36px;
    margin: 0;
    color: #aebbd1;
    font-size: 0.88rem;
    line-height: 1.45;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-next-objective {
    min-height: 54px;
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 9px 11px;
    border-left: 2px solid rgba(103, 232, 249, 0.52);
    background: rgba(255, 255, 255, 0.035);
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-next-objective span {
    color: #dbeafe;
    font-size: 0.88rem;
    line-height: 1.4;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-division-action,
body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-disabled-action {
    width: 100%;
    min-height: 42px;
    margin-top: auto;
    border: 1px solid rgba(103, 232, 249, 0.3);
    color: #dff7ff;
    background:
        linear-gradient(
            180deg,
            rgba(37, 99, 235, 0.25),
            rgba(6, 30, 64, 0.28)
        );
    font-size: 0.86rem;
    font-weight: 800;
    cursor: pointer;
    transition:
        transform 0.18s ease,
        border-color 0.18s ease,
        background 0.18s ease;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-division-action:hover {
    transform: translateY(-1px);
    border-color: rgba(103, 232, 249, 0.62);
    background:
        linear-gradient(
            180deg,
            rgba(37, 99, 235, 0.4),
            rgba(6, 30, 64, 0.4)
        );
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-disabled-action {
    color: #64748b;
    border-color: rgba(148, 163, 184, 0.12);
    background: rgba(255, 255, 255, 0.025);
    cursor: not-allowed;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-meta-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    gap: 14px;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-side-card {
    padding: 17px;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-side-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 15px;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-preview-badge {
    color: #67e8f9;
    border-color: rgba(103, 232, 249, 0.24);
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-leaderboard-list {
    display: grid;
    gap: 8px;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-leaderboard-row {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) auto;
    align-items: center;
    gap: 11px;
    padding: 10px 12px;
    border: 1px solid rgba(255, 255, 255, 0.055);
    background: rgba(255, 255, 255, 0.025);
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-leaderboard-position {
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    color: #67e8f9;
    border: 1px solid rgba(103, 232, 249, 0.2);
    font-family: "Orbitron", sans-serif;
    font-size: 0.72rem;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-leaderboard-row > div {
    display: grid;
    gap: 2px;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-leaderboard-row strong {
    color: #ffffff;
    font-size: 0.88rem;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-leaderboard-row small {
    color: #94a3b8;
    font-size: 0.74rem;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-leaderboard-row b {
    color: #dff7ff;
    font-family: "Orbitron", sans-serif;
    font-size: 0.88rem;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-preview-note,
body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-squad-card p {
    margin: 14px 0 0;
    color: #94a3b8;
    font-size: 0.82rem;
    line-height: 1.5;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-squad-slots {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 6px;
    margin: 18px 0;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-squad-slots span {
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border: 1px solid rgba(148, 163, 184, 0.16);
    color: #475569;
    background: rgba(255, 255, 255, 0.025);
    font-size: 0.72rem;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-squad-slots span.is-filled {
    color: #67e8f9;
    border-color: rgba(103, 232, 249, 0.32);
    background: rgba(56, 189, 248, 0.08);
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-score {
    display: grid;
    justify-items: end;
    gap: 3px;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-score-label {
    color: #94a3b8;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-score > div {
    display: flex;
    align-items: baseline;
    gap: 2px;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-division-summary-mark {
    width: 12px;
    height: 12px;
    display: block;
    border: 1px solid rgba(103, 232, 249, 0.42);
    background: rgba(56, 189, 248, 0.2);
    box-shadow: 0 0 12px rgba(56, 189, 248, 0.22);
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-division-summary-mark[data-yh-summary-division="plaza"] {
    border-color: rgba(167, 139, 250, 0.5);
    background: rgba(139, 92, 246, 0.24);
    box-shadow: 0 0 12px rgba(139, 92, 246, 0.2);
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-division-summary-mark[data-yh-summary-division="federation"] {
    border-color: rgba(211, 178, 112, 0.5);
    background: rgba(211, 178, 112, 0.2);
    box-shadow: 0 0 12px rgba(211, 178, 112, 0.18);
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-leaderboard-row {
    grid-template-columns:
        32px
        minmax(0, 1fr)
        auto;
    column-gap: 14px;
}
body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-leaderboard-position {
    flex: 0 0 auto;
    margin-right: 0;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-leaderboard-row > div {
    min-width: 0;
    padding-left: 2px;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-leaderboard-row b {
    display: grid;
    justify-items: end;
    gap: 1px;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-leaderboard-row b small {
    color: #64748b;
    font-family: "Poppins", sans-serif;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]:not(
    [data-yh-unified-workspace="overview"]
)
.yh-game-foundation {
    display: none;
}
body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-academy-xp-strip {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding: 7px 9px;
    border: 1px solid rgba(103, 232, 249, 0.12);
    background: rgba(56, 189, 248, 0.045);
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-academy-xp-strip span {
    color: #94a3b8;
    font-size: 0.68rem;
    white-space: nowrap;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-academy-xp-strip strong {
    color: #dff7ff;
    font-family: "Orbitron", sans-serif;
    font-size: 0.74rem;
    text-align: center;
}

body[data-yh-view="hub"][data-yh-page="dashboard"]
.yh-game-leaderboard-position {
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(103, 232, 249, 0.22);
    color: #67e8f9;
    font-family: "Orbitron", sans-serif;
    font-size: 0.68rem;
}

@media (max-width: 560px) {
    body[data-yh-view="hub"][data-yh-page="dashboard"]
    .yh-game-academy-xp-strip {
        grid-template-columns: 1fr auto;
    }

    body[data-yh-view="hub"][data-yh-page="dashboard"]
    .yh-game-academy-xp-strip span:last-child {
        grid-column: 1 / -1;
    }

    body[data-yh-view="hub"][data-yh-page="dashboard"]
    .yh-game-academy-xp-strip strong {
        text-align: right;
    }
}
@media (max-width: 1100px) {
    body[data-yh-view="hub"][data-yh-page="dashboard"]
    .yh-game-operator-panel {
        grid-template-columns: minmax(0, 1fr) minmax(180px, 0.42fr);
    }

    body[data-yh-view="hub"][data-yh-page="dashboard"]
    .yh-game-operator-progress {
        grid-column: 1 / -1;
    }

    body[data-yh-view="hub"][data-yh-page="dashboard"]
    .yh-game-division-grid {
        grid-template-columns: 1fr;
    }

    body[data-yh-view="hub"][data-yh-page="dashboard"]
    .yh-game-division-card {
        min-height: 0;
    }
}

@media (max-width: 760px) {
    body[data-yh-view="hub"][data-yh-page="dashboard"]
    .yh-game-foundation {
        padding: 12px;
        gap: 12px;
    }

    body[data-yh-view="hub"][data-yh-page="dashboard"]
    .yh-game-operator-panel {
        grid-template-columns: 1fr;
        gap: 18px;
        padding: 22px 18px;
    }

