    opacity: 0.62;
    cursor: wait;
}

.yh-game-squad-missions-empty,
.yh-game-squad-missions-error {
    min-height: 170px;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 8px;
    padding: 22px;
    border: 1px dashed rgba(148, 163, 184, 0.2);
    border-radius: 12px;
    color: #94a3b8;
    text-align: center;
}

