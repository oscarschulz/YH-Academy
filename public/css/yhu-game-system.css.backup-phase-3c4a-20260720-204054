    opacity: 0.68;
    border-color: rgba(244, 63, 94, 0.2);
}

.yh-game-squad-mission-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
}

.yh-game-squad-mission-head small {
    color: #67e8f9;
    font-family: "Orbitron", sans-serif;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.yh-game-squad-mission-head h3 {
    margin: 4px 0 0;
    color: #f8fbff;
    font-family: "Rajdhani", "Poppins", sans-serif;
    font-size: 1.08rem;
}

.yh-game-squad-mission-head > span {
    padding: 5px 8px;
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 999px;
    color: #94a3b8;
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: capitalize;
}

.yh-game-squad-mission-head > span.is-active {
    border-color: rgba(103, 232, 249, 0.3);
    color: #67e8f9;
}

.yh-game-squad-mission-head > span.is-completed {
    border-color: rgba(34, 197, 94, 0.3);
    color: #86efac;
}

.yh-game-squad-mission-head > span.is-cancelled {
    border-color: rgba(244, 63, 94, 0.3);
    color: #fda4af;
}

