    gap: 14px;
}

.yh-game-squad-mission-card {
    display: grid;
    gap: 11px;
    padding: 14px;
    border: 1px solid rgba(148, 163, 184, 0.16);
    border-radius: 12px;
    background: rgba(2, 8, 23, 0.46);
}

