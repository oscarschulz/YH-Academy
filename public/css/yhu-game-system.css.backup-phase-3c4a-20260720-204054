    min-height: 38px;
    padding: 8px 16px;
    white-space: nowrap;
}

.yh-game-squad-mission-filters button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    padding: 7px 10px;
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 8px;
    background: rgba(2, 8, 23, 0.38);
    color: #94a3b8;
    font: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
    cursor: pointer;
}

.yh-game-squad-mission-filters button span {
