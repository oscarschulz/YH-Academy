.yh-game-squad-missions-error strong {
    color: #f8fbff;
}

.yh-game-squad-missions-empty p,
.yh-game-squad-missions-error p {
    max-width: 420px;
    margin: 0;
    font-size: 0.8rem;
}

.yh-game-squad-mission-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

@media (max-width: 720px) {
    .yh-game-squad-modal-card.is-workspace {
        width: 100%;

        max-height: 94vh;
        max-height: 94dvh;

        padding:
            22px
            16px
            18px;
    }

    .yh-game-squad-modal-content {
        padding-right: 2px;
        scrollbar-gutter: auto;
    }

    .yh-game-squad-workspace-tabs {
        display: flex;
        gap: 6px;

        overflow-x: auto;
        overflow-y: hidden;

        scrollbar-width: thin;
        scrollbar-color:
            #38bdf8
            rgba(2, 8, 23, 0.68);
    }

    .yh-game-squad-workspace-tabs::-webkit-scrollbar {
        height: 6px;
    }

    .yh-game-squad-workspace-tabs::-webkit-scrollbar-track {
        border-radius: 999px;
        background: rgba(2, 8, 23, 0.68);
    }

    .yh-game-squad-workspace-tabs::-webkit-scrollbar-thumb {
        border-radius: 999px;
        background:
            linear-gradient(
                90deg,
                #2563eb,
                #38bdf8,
                #67e8f9
            );
    }

    .yh-game-squad-workspace-tabs::-webkit-scrollbar-thumb:hover {
        background:
            linear-gradient(
                90deg,
                #38bdf8,
                #67e8f9,
                #cffafe
            );
    }

    .yh-game-squad-workspace-tabs button {
        flex: 0 0 auto;
        width: auto;
        min-width: 92px;
    }

    .yh-game-squad-missions-toolbar {
        align-items: stretch;
        flex-direction: column;
    }

    .yh-game-squad-mission-filters {
        width: 100%;
        display: grid;
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .yh-game-squad-mission-filters button {
        width: 100%;
        justify-content: center;
    }

    .yh-game-squad-missions-toolbar
    > .yh-game-squad-primary {
        width: 100%;
        min-width: 0;
    }

    .yh-game-squad-missions-list {
        grid-template-columns: 1fr;
    }

    .yh-game-squad-mission-form-grid {
        grid-template-columns: 1fr;
    }

    .yh-game-squad-mission-head {
        align-items: flex-start;
    }

    .yh-game-squad-mission-actions {
        justify-content: stretch;
    }

    .yh-game-squad-mission-actions button {
        flex: 1;
    }
}

